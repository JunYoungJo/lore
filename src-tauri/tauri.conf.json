{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lore",
  "version": "0.1.0",
  "identifier": "io.github.junyoungjo.lore",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1460",
    "beforeDevCommand": "pnpm build:cli && pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"],
    "externalBin": ["binaries/lore-cli"],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
