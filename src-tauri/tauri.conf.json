{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lore",
  "version": "0.3.2",
  "identifier": "io.github.junyoungjo.lore",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1460",
    "beforeDevCommand": "pnpm build:cli && pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/lore-cli"
    ],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4RTU1NUNDNTM3RDM0NzcKUldSM05IMVR6RlhsdU1zZGI1MWd5WVZZamQvSm80VVJCYldDZ1k4LzdYVzhsYWJUYXA1YnhTYmEK",
      "endpoints": [
        "https://github.com/JunYoungJo/lore/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
